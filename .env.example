# Copie este arquivo pra ".env" (dev local) e ajuste se precisar.
# ".env" nunca é commitado (ver .gitignore) — é a config real de cada máquina/ambiente.

APP_ENV=dev
BACKEND_PORT=3000
FRONTEND_PORT=8080

# URL que o FRONTEND usa pra falar com o backend.
# Em dev local, é localhost mesmo porque o navegador roda fora do Docker.
VITE_API_URL=http://localhost:3000
