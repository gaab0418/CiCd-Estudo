# Copie pra ".env.staging" na sua VM/WSL. Usado pelo workflow da branch "staging".
# Portas diferentes do .env.production de propósito: os dois ambientes rodam
# ao mesmo tempo na mesma máquina, então não podem colidir.

APP_ENV=staging
BACKEND_PORT=3001
FRONTEND_PORT=8081
VITE_API_URL=http://localhost:3001
